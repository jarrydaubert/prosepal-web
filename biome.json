{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {},
      "suspicious": {},
      "style": {},
      "complexity": {},
      "performance": {},
      "security": {}
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "files": {
    "includes": [
      "**/*.json",
      "**/*.js",
      "!**/node_modules",
      "!**/bun.lockb",
      "!**/.vercel",
      "!**/public/.well-known"
    ]
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "trailingCommas": "none"
    },
    "linter": {
      "enabled": true
    }
  }
}
