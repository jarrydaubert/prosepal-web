# Optional local override for deterministic generated dates.
# Leave blank during normal development; generators resolve dates from content metadata.
PROSEPAL_CONTENT_DATE=

# Optional local validation target for conversion-event checks.
CONVERSION_TARGET_URL=

# Emergency-only local production deploy guard.
# Do not set for normal merge-to-main deploys.
ALLOW_PROD_CLI_DEPLOY=

# Optional Vercel link guards for local deploy validation.
EXPECTED_VERCEL_PROJECT_ID=
EXPECTED_VERCEL_ORG_ID=

# Optional local-only GitHub governance audit inputs.
# Never commit real tokens in .env files.
GH_REPO=
GH_ADMIN_TOKEN_EXPIRES_ON=
GH_CI_MONTHLY_MINUTES_REVIEW=
GH_CI_MONTHLY_MINUTES_MAX=
GH_CI_AVG_MINUTES_MAX=
GH_CI_CODEQL_AVG_MINUTES_MAX=
