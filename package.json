{
  "name": "prosepal-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bunx serve public -l 3000",
    "build": "bun run generate:site && echo 'Static site build artifacts generated'",
    "generate:site": "node scripts/generate-seo-artifacts.js",
    "generate:messages": "node scripts/generate-messages.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:robots": "node scripts/generate-robots.js",
    "generate:llms": "node scripts/generate-llms.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "audit:styles": "node scripts/audit-styles.js",
    "audit:styles:strict": "node scripts/audit-styles.js --fail-on-thresholds --show-thresholds",
    "test:metadata": "node scripts/test-metadata.js",
    "test:artifacts": "node scripts/test-seo-artifacts.js",
    "validate:a11y:baseline": "node scripts/validate-accessibility-regression.js",
    "validate:a11y:manual": "node scripts/validate-accessibility-manual.js",
    "validate:csp:runtime": "node scripts/validate-csp-runtime.js",
    "validate:events:conversion": "node scripts/validate-conversion-events.js",
    "validate:formspree:strategy": "node scripts/validate-formspree-strategy.js",
    "validate:social:prod": "node scripts/validate-social-preview.js",
    "validate:canonical:routes": "node scripts/validate-canonical-routes.js",
    "validate:schema:local": "node scripts/validate-schema-spotcheck.js",
    "validate:schema:prod": "bun run validate:schema:local",
    "audit:github:policy": "node scripts/audit-github-policy-drift.js",
    "audit:ci:usage": "node scripts/audit-ci-usage-budget.js",
    "release:qa": "bun run validate:social:prod && bun run validate:schema:prod && bun run validate:canonical:routes",
    "release:prepare": "node scripts/prepare-release-notes.js",
    "validate": "node scripts/validate-site.js",
    "check": "bun run generate:site && bun run lint && bun run test:metadata && bun run test:artifacts && bun run validate && bun run validate:schema:local && bun run validate:a11y:baseline && bun run audit:styles:strict",
    "vercel:check-link": "node scripts/check-vercel-project.js",
    "deploy:preview": "bun run vercel:check-link && vercel",
    "deploy:prod": "bun run check && bun run vercel:check-link && node scripts/enforce-prod-deploy-policy.js && vercel --prod --yes"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@playwright/test": "^1.58.2",
    "serve": "^14.2.5"
  }
}
